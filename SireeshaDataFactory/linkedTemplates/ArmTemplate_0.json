					"server": "[parameters('AzureDBLinkedService_properties_typeProperties_server')]",
					"database": "[parameters('AzureDBLinkedService_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('AzureDBLinkedService_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('AzureDBLinkedService_password')]"
					}
				}
			},
			"dependsOn": []
