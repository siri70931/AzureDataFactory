{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "SireeshaDataFactory"
		},
		"AzureDBLinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureDBLinkedService'"
		},
		"LinkedService1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LinkedService1'"
		},
		"AzureDBLinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sdbserver.database.windows.net"
		},
		"AzureDBLinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureDB1"
		},
		"AzureDBLinkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Admin_Sireesha"
		},
		"GitLinkedService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"LinkedService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sireeshastoragegroup.dfs.core.windows.net/"
		},
		"RestService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "SireeshaDataFactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDBLinkedService_password": {
						"value": "[parameters('AzureDBLinkedService_password')]"
					},
					"LinkedService1_accountKey": {
						"value": "[parameters('LinkedService1_accountKey')]"
					},
					"AzureDBLinkedService_properties_typeProperties_server": {
						"value": "[parameters('AzureDBLinkedService_properties_typeProperties_server')]"
					},
					"AzureDBLinkedService_properties_typeProperties_database": {
						"value": "[parameters('AzureDBLinkedService_properties_typeProperties_database')]"
					},
					"AzureDBLinkedService_properties_typeProperties_userName": {
						"value": "[parameters('AzureDBLinkedService_properties_typeProperties_userName')]"
					},
					"GitLinkedService_properties_typeProperties_url": {
						"value": "[parameters('GitLinkedService_properties_typeProperties_url')]"
					},
					"LinkedService1_properties_typeProperties_url": {
						"value": "[parameters('LinkedService1_properties_typeProperties_url')]"
					},
					"RestService_properties_typeProperties_url": {
						"value": "[parameters('RestService_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "SireeshaDataFactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'SireeshaDataFactory_ArmTemplate_0')]"
			]
		}
	]
}